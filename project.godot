; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Dyscoach Jeux"
config/description="Moteur de jeux éducatifs pour enfants DYS. Outil d'accompagnement pédagogique : ni diagnostic, ni traitement."
run/main_scene="res://ui/screens/home.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Access="*res://autoload/accessibility.gd"
AudioMgr="*res://autoload/audio_manager.gd"
Content="*res://autoload/content_manager.gd"
SR="*res://autoload/spaced_repetition_manager.gd"
Progress="*res://autoload/progress_manager.gd"
App="*res://autoload/app.gd"

[gui]

; Netteté des polices (rendu Web + échelles fractionnaires d'iframe) :
; MSDF = texte net à n'importe quelle échelle/zoom, hinting fort = bords accrochés aux pixels.
theme/default_font_multichannel_signed_distance_field=true
theme/default_font_hinting=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; UI statique : accroche les transformations aux pixels entiers (bordures/lignes nettes
; malgré l'échelle fractionnaire de l'iframe).
2d/snap/snap_2d_transforms_to_pixel=true
