[resource]
script = ExtResource("1")
exercise_id = "orth.homophones"
display_name = "Les jumeaux des mots"
description = "Distinguer les homophones fréquents (a/à, et/est, on/ont, son/sont, ou/où) avec des astuces de substitution."
domain = "orthographe"
skill = "homophones"
prerequisites = []
base_level = 3
age_min = 8
age_max = 12
instruction_text = "Complète la phrase en touchant le bon mot. Les astuces t'aident : teste le remplacement suggéré."
scene_path = "res://games/quiz_tap.tscn"
artwork_note = "Deux mots jumeaux mais pas identiques ; gros boutons."
items = [SubResource("Item1"), SubResource("Item2"), SubResource("Item3"), SubResource("Item4"), SubResource("Item5"), SubResource("Item6"), SubResource("Item7"), SubResource("Item8"), SubResource("Item9"), SubResource("Item10")]
interaction = "tap"
duration_minutes = 5
adaptive_params = {
"failure_threshold_down": 0.34,
"items_per_session": 6,
"max_attempts_per_item": 3
}
source_note = "Homophones grammaticaux : apprentissage par astuces de substitution (classe grammaticale plutôt que mémorisation brute) — pratique standard en orthopédagogie, à valider par un spécialiste."
evidence_level = "prometteur"
validation_status = "brouillon"
variant_of = ""
