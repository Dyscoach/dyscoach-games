[resource]
script = ExtResource("1")
exercise_id = "espace.robot_a_guider"
display_name = "Le robot à guider"
description = "Séquençage spatial : traduire une consigne de déplacement en ordres successifs."
domain = "coordination_espace"
skill = "orientation_spatiale"
prerequisites = []
base_level = 3
age_min = 6
age_max = 9
instruction_text = "Écoute la mission. Appuie sur les flèches pour amener le robot au cadeau, dans le bon ordre."
scene_path = "res://games/robot_guide.tscn"
artwork_note = "Grille douce, robot rond, flèches colorées et repérées par icônes (jamais la couleur seule)."
items = [SubResource("Item1"), SubResource("Item2"), SubResource("Item3"), SubResource("Item4"), SubResource("Item5"), SubResource("Item6")]
interaction = "sequence"
duration_minutes = 6
adaptive_params = {
"failure_threshold_down": 0.34,
"items_per_session": 4,
"max_attempts_per_item": 3
}
source_note = "Séquençage de gestes et repérage spatial ; tâches concrètes et progressives. Aucune promesse de transfert automatique vers l'écriture (prudence sur les « jeux de coordination »)."
evidence_level = "prometteur"
validation_status = "brouillon"
variant_of = ""
