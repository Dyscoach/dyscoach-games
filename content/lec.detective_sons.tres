[resource]
script = ExtResource("1")
exercise_id = "lec.detective_sons"
display_name = "Le détective des sons"
description = "Repérer si un son est présent dans un mot (conscience phonologique)."
domain = "langage_ecrit"
skill = "reconnaissance_sons"
prerequisites = []
base_level = 2
age_min = 5
age_max = 12
instruction_text = "Écoute bien le mot. Appuie sur OUI si tu entends le son [a], sur NON sinon."
scene_path = "res://games/detective_sons.tscn"
artwork_note = "Loupe de détective, cartes-mots, boutons OUI/NON verts et rouges avec icônes ✓ et ✗."
items = [SubResource("Item1"), SubResource("Item2"), SubResource("Item3"), SubResource("Item4"), SubResource("Item5"), SubResource("Item6"), SubResource("Item7"), SubResource("Item8")]
interaction = "listen"
duration_minutes = 4
adaptive_params = {
"failure_threshold_down": 0.34,
"items_per_session": 6,
"max_attempts_per_item": 2
}
source_note = "La conscience phonologique est un prédicteur robuste de la lecture (rapport INSERM « Dyslexie » 2007 ; enseignement explicite et systématique du code : NRP 2000)."
evidence_level = "etabli"
validation_status = "brouillon"
