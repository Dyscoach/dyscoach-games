[resource]
script = ExtResource("1")
exercise_id = "lec.train_syllabes"
display_name = "Le train des syllabes"
description = "Assembler des syllabes pour reconstituer un mot entendu (fusion syllabique)."
domain = "langage_ecrit"
skill = "assemblage_syllabes"
prerequisites = ["reconnaissance_sons"]
base_level = 2
age_min = 5
age_max = 8
instruction_text = "Écoute le mot. Remets les wagons-syllabes dans l'ordre pour écrire le mot."
scene_path = "res://games/syllable_train.tscn"
artwork_note = "Locomotive joyeuse + wagons draggable ; syllabes en très gros caractères."
items = [SubResource("Item1"), SubResource("Item2"), SubResource("Item3"), SubResource("Item4"), SubResource("Item5"), SubResource("Item6"), SubResource("Item7"), SubResource("Item8")]
interaction = "drag"
duration_minutes = 5
adaptive_params = {
"failure_threshold_down": 0.34,
"items_per_session": 6,
"max_attempts_per_item": 2
}
source_note = "Fusion et segmentation syllabiques, étapes fondatrices du décodage (INSERM 2007 ; Goigoux 2016)."
evidence_level = "etabli"
validation_status = "brouillon"
variant_of = ""
