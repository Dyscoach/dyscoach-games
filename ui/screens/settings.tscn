[node name="Note" type="Label" parent="Root/Scroll/Box"]
theme_override_font_sizes/font_size = 16
autowrap_mode = 3
text = "La police « adaptée dys » est une préférence de confort de lecture. Elle ne soigne pas la dyslexie."
horizontal_alignment = 1

[node name="SaveButton" type="Button" parent="Root"]
custom_minimum_size = Vector2(0, 84)
text = "✅ Enregistrer"

[connection signal="value_changed" from="Root/Scroll/Box/FontSizeRow/FontSizeSlider" to="." method="_on_font_size_changed"]
[connection signal="value_changed" from="Root/Scroll/Box/LetterRow/LetterSlider" to="." method="_on_letter_changed"]
[connection signal="value_changed" from="Root/Scroll/Box/LineRow/LineSlider" to="." method="_on_line_changed"]
[connection signal="toggled" from="Root/Scroll/Box/ContrastCheck" to="." method="_on_contrast_toggled"]
