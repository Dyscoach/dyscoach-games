[node name="VolumeRow" type="HBoxContainer" parent="Root/Scroll/Box"]
theme_override_constants/separation = 12

[node name="VolumeLabel" type="Label" parent="Root/Scroll/Box/VolumeRow"]
theme_override_font_sizes/font_size = 20
text = "Volume :"
