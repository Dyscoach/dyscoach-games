[connection signal="toggled" from="Root/Scroll/Box/ReduceMotionCheck" to="." method="_on_reduce_motion_toggled"]
[connection signal="toggled" from="Root/Scroll/Box/ReduceEffectsCheck" to="." method="_on_reduce_effects_toggled"]
[connection signal="toggled" from="Root/Scroll/Box/SubtitlesCheck" to="." method="_on_subtitles_toggled"]
[connection signal="value_changed" from="Root/Scroll/Box/VolumeRow/VolumeSlider" to="." method="_on_volume_changed"]
[connection signal="value_changed" from="Root/Scroll/Box/VoiceRateRow/VoiceRateSlider" to="." method="_on_voice_rate_changed"]
[connection signal="pressed" from="Root/SaveButton" to="." method="_on_save_pressed"]
