[node name="LineSlider" type="HSlider" parent="Root/Scroll/Box/LineRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
min_value = 1.0
max_value = 2.0
value = 1.0
step = 0.1

[node name="Confort" type="Label" parent="Root/Scroll/Box"]
theme_override_font_sizes/font_size = 24
text = "🎨 Confort visuel"

[node name="ContrastCheck" type="CheckBox" parent="Root/Scroll/Box"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 20
