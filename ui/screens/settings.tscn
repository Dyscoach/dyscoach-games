[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/screens/settings.gd" id="1"]

[sub_resource type="ButtonGroup" id="bg1"]

[node name="Settings" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.976471, 0.960784, 0.92549, 1)

[node name="Root" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = 20.0
offset_right = -40.0
offset_bottom = -20.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Root"]
theme_override_font_sizes/font_size = 38
text = "⚙️ Réglages d'accessibilité"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Root"]
size_flags_vertical = 3

[node name="Box" type="VBoxContainer" parent="Root/Scroll"]
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Lecture" type="Label" parent="Root/Scroll/Box"]
theme_override_font_sizes/font_size = 24
text = "📖 Lecture"

[node name="FontRow" type="HBoxContainer" parent="Root/Scroll/Box"]
theme_override_constants/separation = 12

[node name="FontLabel" type="Label" parent="Root/Scroll/Box/FontRow"]
theme_override_font_sizes/font_size = 20
text = "Police :"
vertical_alignment = 1

[node name="FontDefaut" type="CheckBox" parent="Root/Scroll/Box/FontRow"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 18
text = "Défaut"
button_group = SubResource("bg1")

[node name="FontLisible" type="CheckBox" parent="Root/Scroll/Box/FontRow"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 18
text = "Lisible"
button_group = SubResource("bg1")

[node name="FontDys" type="CheckBox" parent="Root/Scroll/Box/FontRow"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 18
text = "Adaptée dys (confort)"
button_group = SubResource("bg1")

[node name="FontSizeRow" type="HBoxContainer" parent="Root/Scroll/Box"]
theme_override_constants/separation = 12

[node name="FontSizeLabel" type="Label" parent="Root/Scroll/Box/FontSizeRow"]
theme_override_font_sizes/font_size = 20
text = "Taille du texte :"
vertical_alignment = 1

[node name="FontSizeSlider" type="HSlider" parent="Root/Scroll/Box/FontSizeRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
min_value = 0.0
max_value = 3.0
value = 1.0
step = 1.0

[node name="FontSizeValue" type="Label" parent="Root/Scroll/Box/FontSizeRow"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 20
text = "Moyen"

[node name="LetterRow" type="HBoxContainer" parent="Root/Scroll/Box"]
theme_override_constants/separation = 12

[node name="LetterLabel" type="Label" parent="Root/Scroll/Box/LetterRow"]
theme_override_font_sizes/font_size = 20
text = "Espacement lettres :"
vertical_alignment = 1

[node name="LetterSlider" type="HSlider" parent="Root/Scroll/Box/LetterRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
min_value = 1.0
max_value = 2.0
value = 1.0
step = 0.1

[node name="LineRow" type="HBoxContainer" parent="Root/Scroll/Box"]
theme_override_constants/separation = 12

[node name="LineLabel" type="Label" parent="Root/Scroll/Box/LineRow"]
theme_override_font_sizes/font_size = 20
text = "Espacement lignes :"
