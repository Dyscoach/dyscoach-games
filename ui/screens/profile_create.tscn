[node name="DomainsTitle" type="Label" parent="Root"]
theme_override_font_sizes/font_size = 22
text = "Ce qui t'intéresse (tu peux en choisir plusieurs) :"

[node name="DomainsScroll" type="ScrollContainer" parent="Root"]
size_flags_vertical = 3

[node name="DomainsBox" type="VBoxContainer" parent="Root/DomainsScroll"]
