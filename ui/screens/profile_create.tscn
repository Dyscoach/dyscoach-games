[node name="NameLabel" type="Label" parent="Root"]
theme_override_font_sizes/font_size = 22
text = "Prénom ou surnom (facultatif) :"

[node name="NameEdit" type="LineEdit" parent="Root"]
unique_name_in_owner = true
