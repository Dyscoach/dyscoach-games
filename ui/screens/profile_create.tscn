grow_vertical = 2
color = Color(0.976471, 0.960784, 0.92549, 1)

[node name="Root" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 24.0
offset_right = -48.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2
