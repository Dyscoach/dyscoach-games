[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/screens/home.gd" id="1"]

[node name="Home" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.976471, 0.960784, 0.92549, 1)

[node name="Root" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 32.0
offset_top = 24.0
offset_right = -32.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="TitleLabel" type="Label" parent="Root"]
theme_override_font_sizes/font_size = 54
text = "Dyscoach Jeux"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="Root"]
theme_override_font_sizes/font_size = 22
text = "Qui joue aujourd'hui ?"
horizontal_alignment = 1

[node name="ProfileScroll" type="ScrollContainer" parent="Root"]
size_flags_vertical = 3

[node name="ProfileList" type="VBoxContainer" parent="Root/ProfileScroll"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="NoProfileLabel" type="Label" parent="Root/ProfileScroll/ProfileList"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 22
text = "Crée le premier profil pour commencer ✨"
horizontal_alignment = 1

[node name="ButtonsRow" type="HBoxContainer" parent="Root"]
alignment = 1
theme_override_constants/separation = 24

[node name="NewProfileButton" type="Button" parent="Root/ButtonsRow"]
custom_minimum_size = Vector2(0, 84)
text = "➕ Nouveau profil"

[node name="SettingsButton" type="Button" parent="Root/ButtonsRow"]
custom_minimum_size = Vector2(0, 84)
text = "⚙️ Réglages"

[node name="AdultButton" type="Button" parent="Root/ButtonsRow"]
custom_minimum_size = Vector2(0, 84)
text = "📊 Espace adulte"

[node name="VersionLabel" type="Label" parent="Root"]
unique_name_in_owner = true
theme_override_font_sizes/font_size = 14
text = ""
horizontal_alignment = 1

[connection signal="pressed" from="Root/ButtonsRow/NewProfileButton" to="." method="_on_new_profile_pressed"]
[connection signal="pressed" from="Root/ButtonsRow/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="Root/ButtonsRow/AdultButton" to="." method="_on_adult_pressed"]
